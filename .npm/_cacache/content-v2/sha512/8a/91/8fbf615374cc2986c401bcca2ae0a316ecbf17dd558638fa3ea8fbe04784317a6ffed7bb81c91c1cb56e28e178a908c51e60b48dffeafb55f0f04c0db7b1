your current working directory\n\n#### Example\n\n```javascript\ninquirer.registerPrompt('directory', require('inquirer-directory'));\ninquirer.prompt([{\n  type: 'directory',\n  name: 'from',\n  message: 'Where you like to put this component?',\n  basePath: './src'\n}]).then(function(answers) {\n  // (answers.from is the path chosen)\n});\n```\n\n[![asciicast](https://asciinema.org/a/31651.png)](https://asciinema.org/a/31651)\n\nSee also [example.js](https://github.com/nicksrandall/inquierer-directory/blob/master/example.js) for a working example\n\n## License\n\nMIT\n","maintainers":[{"email":"nicksrandall@gmail.com","name":"nicksrandall"},{"email":"sebdeckers83@gmail.com","name":"seb"}],"time":{"modified":"2022-06-19T01:28:03.352Z","created":"2015-12-10T18:33:55.855Z","1.0.1":"2015-12-10T18:33:55.855Z","1.1.0":"2015-12-10T21:34:51.396Z","1.1.1":"2015-12-11T17:53:17.497Z","1.1.2":"2015-12-11T21:01:20.881Z","1.1.3":"2015-12-11T22:01:21.076Z","1.1.4":"2016-01-28T21:04:36.446Z","2.0.0":"2016-03-02T20:41:44.015Z","2.1.0":"2016-11-08T20:51:31.124Z","2.2.0":"2019-07-20T17:48:00.118Z"},"homepage":"https://github.com/nicksrandall/inquierer-directory#readme","keywords":["Inquirer","directory","prompt"],"repository":{"type":"git","url":"git+https://github.com/nicksrandall/inquierer-directory.git"},"author":{"name":"Nick Randall","email":"nicksrandall@gmail.com","url":"http://nickrandall.com"},"bugs":{"url":"https://github.com/nicksrandall/inquierer-directory/issues"},"license":"MIT","readmeFilename":"README.md","users":{"lestad":true,"zoxon":true}}